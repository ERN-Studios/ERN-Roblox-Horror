-- Failed/disabled/destroyed gaze owners can leave stale diagnostic attributes.
local watcherKeys={"watcher_heartbeat","watcher_glass","watcher_breath","watcher_recede"}
local function primeWatcherVoices() for _,key in ipairs(watcherKeys) do voice(key):Play() end end
local function watcherSilent(label) for _,key in ipairs(watcherKeys) do eq(voice(key).IsPlaying,false,label.." "..key) end end
