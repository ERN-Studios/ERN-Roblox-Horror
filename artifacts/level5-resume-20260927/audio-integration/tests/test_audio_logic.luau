local Logic=require("../patches/Level5AudioLogic.ModuleScript")
local Catalog=require("../patches/Level5AudioCatalog.ModuleScript")
local count=0
local function eq(actual,expected,label)
	count+=1;assert(actual==expected,(label or "equality")..": expected "..tostring(expected)..", got "..tostring(actual))
end
for _,value in ipairs({0,-1,1.5,math.huge,-math.huge,0/0,"","0","-1","https://bad",string.rep("9",400)}) do
	eq(Logic.AssetId(value),nil,"invalid asset")
end
eq(Logic.AssetId(12345),"rbxassetid://12345")
eq(Logic.AssetId("12345"),"rbxassetid://12345")
eq(Logic.AssetId("rbxassetid://12345"),"rbxassetid://12345")
local voices=0
for _,cue in pairs(Catalog) do voices+=1;eq(Logic.AssetId(cue.AssetId),nil,"placeholder silent") end
eq(voices,12,"voice cap")
for gate=1,7 do
	local s=Logic.New();local token={}
	eq(Logic.Gate(s,gate,token,false),false,"initial locked baseline")
	eq(Logic.Gate(s,gate,token,true),true,"real open")
	eq(Logic.Gate(s,gate,token,true),false,"no repeat")
	eq(Logic.Gate(s,gate,{},true),false,"streamed replacement baseline")
	eq(Logic.Gate(Logic.New(),gate,token,true),false,"late join already open")
	eq(Logic.Gate(Logic.New(),gate,token,nil),false,"missing attribute")
	local split=Logic.New()
	Logic.Gate(split,gate,token,false,nil,10)
	local opened,unlock=Logic.Gate(split,gate,token,true,nil,10.1)
	eq(opened,true,"server Unlocked arrives first");eq(unlock,false,"reason not replicated yet")
	opened,unlock=Logic.Gate(split,gate,token,true,nil,10.3)
	eq(opened,false,"pending does not replay slide");eq(unlock,false,"still pending reason")
	opened,unlock=Logic.Gate(split,gate,token,true,"SOLVED",10.5)
	eq(opened,false,"reason arrived later");eq(unlock,true,"delayed solved reason emits unlock")
	opened,unlock=Logic.Gate(split,gate,token,true,"SOLVED",10.6)
	eq(opened,false,"no slide duplicate");eq(unlock,false,"no unlock duplicate")
	opened,unlock=Logic.Gate(Logic.New(),gate,token,true,"SOLVED",10.6)
	eq(opened,false,"initial true solved baseline");eq(unlock,false,"initial solved no unlock")
end
local expired=Logic.New();local token={}
Logic.Gate(expired,1,token,false,nil,20);Logic.Gate(expired,1,token,true,nil,20.1)
local _,unlock=Logic.Gate(expired,1,token,true,"SOLVED",21.2)
eq(unlock,false,"pending reason expires")
local replaced=Logic.New();Logic.Gate(replaced,1,token,false,nil,30);Logic.Gate(replaced,1,token,true,nil,30.1)
_,unlock=Logic.Gate(replaced,1,{},true,"SOLVED",30.2)
eq(unlock,false,"replacement cannot inherit pending cue")
local bypass=Logic.New();Logic.Gate(bypass,1,token,false,nil,40);Logic.Gate(bypass,1,token,true,nil,40.1)
_,unlock=Logic.Gate(bypass,1,token,true,"DEV_BYPASS",40.2)
eq(unlock,false,"bypass does not chime")
_,unlock=Logic.Gate(bypass,1,token,true,"SOLVED",40.3)
eq(unlock,false,"resolved reason is not reconsidered")
for _,index in ipairs({0,8,1.5,math.huge,0/0}) do eq(Logic.Gate(Logic.New(),index,{},true),false) end
local s=Logic.New()
eq(Logic.Power(s,"NORMAL",nil,false),nil)
eq(Logic.Power(s,"FALLING",10,false),"power_fall")
eq(Logic.Power(s,"FALLING",10,false),nil)
eq(Logic.Power(s,"BLACKOUT",10,false),nil)
eq(Logic.Power(s,"BLACKOUT",10,false),nil,"extended outage no fall replay")
eq(Logic.Power(s,"RECOVERING",10,false),"power_restart")
eq(Logic.Power(s,"RECOVERING",10,false),nil)
eq(Logic.Power(s,"NORMAL",10,false),nil)
eq(Logic.Power(s,"FALLING",90,false),"power_fall","new cycle")
eq(Logic.Power(s,"BLACKOUT",90,true),nil,"H exempt")
eq(Logic.Power(s,"RECOVERING",90,true),nil,"H exempt recovery")
eq(Logic.Power(s,"RECOVERING",90,false),nil,"crossing into recovery no replay")
for _,phase in ipairs({"NORMAL","FALLING","BLACKOUT","RECOVERING"}) do eq(Logic.Power(Logic.New(),phase,10,false),nil,"initial phase silent") end
local function observation(overrides)
	local v={present=true,appearance=1,allowed=true,visible=true,hidden=false,lineOfSight=true,distance=30,intensity=.5,
		glassAudible=true,breathAudible=true,recedeAudible=true}
	for k,value in pairs(overrides or {}) do v[k]=value end
	return v
end
local function watch(state,input,time,gain,cues,label)
	local actual,events=Logic.Watcher(state,input,time)
	eq(actual,gain,label);eq(table.concat(events,","),cues,label)
end
s=Logic.New()
watch(s,observation({lineOfSight=false}),1,0,"","behind wall")
watch(s,observation({allowed=false}),2,0,"","modal")
watch(s,observation({hidden=true}),3,0,"","already hidden")
watch(s,observation(),4,.5,"watcher_glass","first eligible")
watch(s,observation(),5,.5,"","not breathing yet")
watch(s,observation(),6,.5,"watcher_breath","close sustained gaze")
watch(s,observation(),7,.5,"","no breath repeats")
watch(s,observation({hidden=true}),8,0,"watcher_recede","gaze disappearance")
watch(s,observation({hidden=true}),9,0,"","disappear once")
watch(s,observation({appearance=2}),10,.5,"watcher_glass","new appearance")
watch(s,observation({present=false,appearance=2}),11,0,"","stream out")
watch(s,observation({appearance=2,hidden=true}),12,0,"","streamed hidden no fake disappearance")
watch(s,observation({appearance=2}),13,.5,"watcher_breath","same appearance no glass repeat")
watch(s,observation({appearance=2,lineOfSight=false,hidden=true}),14,0,"","no recede through wall")
watch(s,observation({appearance=3,distance=145}),15,0,"","outside near range")
watch(s,observation({appearance=3,intensity=0/0}),16,0,"","invalid intensity")
watch(s,observation({appearance=3,distance=math.huge}),17,0,"","invalid distance")
watch(s,observation({appearance=3}),18,.5,"watcher_glass","eligible after invalid input")
watch(s,observation({appearance=3,visible=false}),19,0,"","normal timeout quiet")
watch(s,observation({appearance=4}),20,.5,"watcher_glass","new appearance again")
watch(s,observation({appearance=4,allowed=false,hidden=true}),21,0,"","hidden while modal quiet")
s=Logic.New()
watch(s,observation({distance=100,glassAudible=false,breathAudible=false}),1,.5,"","visible beyond audible glass range")
watch(s,observation({distance=70,breathAudible=false}),2,.5,"watcher_glass","approach still gets first glass")
watch(s,observation({distance=30,breathAudible=false}),3,.5,"","nominal gaze close but actual emitter out of breath range")
watch(s,observation({distance=30}),4,.5,"watcher_breath","breath eligibility not consumed outside real range")
watch(s,observation({hidden=true,recedeAudible=false}),5,0,"","inaudible disappearance is not played")
watch(s,observation({hidden=true}),6,0,"","old disappearance not queued")
print("PASS audio logic: "..count.." assertions")
