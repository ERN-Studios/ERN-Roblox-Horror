+    -- The native floor already carries the Level 3 reference texture and its
+    -- fixed studs-per-tile repeat. Keep the Blender wall/ceiling/furniture kit,
+    -- and expose this exact floor instead of a competing stretched atlas skin.
+    -- Candidate requires fresh Studio verification of texture IDs and repeats.
+    local function revealReferenceFloor(parent, name)
+        local floor = assert(parent:FindFirstChild(name), "Missing reference floor " .. name)
+        assert(floor:IsA("Part"), "Expected native floor proxy " .. name)
+        floor.Transparency = floor:GetAttribute("Level6_LegacyTransparency") or 0
+        for _, child in ipairs(floor:GetChildren()) do
+            if child:IsA("Texture") and child.Face == Enum.NormalId.Top then
+                child.Transparency = 0
+            end
+        end
+        floor:SetAttribute("Level6_OriginalFloorVisible", true)
+        return floor
+    end
