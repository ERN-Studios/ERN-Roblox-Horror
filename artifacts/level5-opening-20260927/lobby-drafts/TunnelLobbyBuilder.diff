+			piece("UpperBalconySlab",frame*CF(0,10.7,-1.5),V(9,.3,2.6),palette.cream,Enum.Material.Plaster)
+			piece("WhiteBalconyHandrail",frame*CF(0,13.2,-2.68),V(9,.16,.16),palette.white,Enum.Material.Wood)
