"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from pathlib import Path
import numpy as np
from PIL import Image

specs = {
    \"tex_wall_synth_panels.png\": (5, 48),
    \"tex_carpet_arcade_synth.png\": (96, 96),
    \"tex_carpet_aud_synth.png\": (64, 64),
    \"tex_carpet_lobby_synth.png\": (64, 64),
}
for name, (bx, by) in specs.items():
    path = Path(name)
    a = np.asarray(Image.open(path).convert(\"RGB\"), dtype=np.float32).copy()
    h, w, _ = a.shape
    assert h == w
    if name == \"tex_wall_synth_panels.png\":
        raw = a.copy()
        a[:, -13:, :] = raw[:, 616:629, :]
        a[:, :13, :] = raw[:, 629:642, :]
    weight = np.cos(np.linspace(0, np.pi / 2, bx, dtype=np.float32)) ** 2
    left = a[:, :bx, :].copy()
    right = a[:, -bx:, :][:, ::-1, :].copy()
    avg = (left + right) / 2
    a[:, :bx, :] = left * (1 - weight[None, :, None]) + avg * weight[None, :, None]
    a[:, -bx:, :] = (right * (1 - weight[None, :, None]) + avg * weight[None, :, None])[:, ::-1, :]
    weight = np.cos(np.linspace(0, np.pi / 2, by, dtype=np.float32)) ** 2
    top = a[:by, :, :].copy()
    bottom = a[-by:, :, :][::-1, :, :].copy()
    avg = (top + bottom) / 2
    a[:by, :, :] = top * (1 - weight[:, None, None]) + avg * weight[:, None, None]
    a[-by:, :, :] = (bottom * (1 - weight[:, None, None]) + avg * weight[:, None, None])[::-1, :, :]
    out = np.rint(np.clip(a, 0, 255)).astype(np.uint8)
    assert np.array_equal(out[:, 0], out[:, -1]) and np.array_equal(out[0], out[-1])
    Image.fromarray(out).save(path)
    print(f\"{name}: {w}x{h}, seamless RGB edges, {path.stat().st_size} bytes\")

