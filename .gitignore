# Claude Code local settings / project data — not part of the game
.claude/

# Studio MCP sync artifacts — regenerated on every sync (manifest IS tracked)
studio-sync.rbxl
studio-sync.rbxl.lock

# stray Windows/installer junk — never game content
*.winmd
*.exe
*.msi

# local stash for downloads/installers that ended up in the repo folder
_local/

# Python bytecode (tools/)
__pycache__/
*.pyc

# Generated by tools/tests (fake-Studio scratch program + luau binary)
tools/tests/_fakestudio_run.luau
tools/tests/luau

# Pre-push copies of Studio scripts, written by tools/push_repo_to_studio.py
.studio-push-backups/
